{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "gateway",
    "workspaceNamespace",
    "workspaceImage",
    "workspaceTemplate",
    "taskQueue"
  ],
  "properties": {
    "gateway": {
      "type": "object",
      "required": ["domain", "tls", "oidc"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "ゲートウェイの公開ドメイン。ワークスペースのホスト名はこの直下の単一ラベルになる。"
        },
        "tls": {
          "type": "object",
          "required": ["secretName"],
          "properties": {
            "secretName": {
              "type": "string",
              "minLength": 1,
              "description": "gateway.domain 宛の TLS 証明書を保持する Secret 名。"
            }
          }
        },
        "oidc": {
          "type": "object",
          "required": ["issuer", "audience", "jwksUrl"],
          "properties": {
            "issuer": { "type": "string", "minLength": 1 },
            "audience": { "type": "string", "minLength": 1 },
            "jwksUrl": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ingress", "traefik"],
          "description": "プレビュー/レポートの入口を生成する実装 (3.1/3.2)。ingress は標準 Kubernetes Ingress のみで配備できる。"
        },
        "ingressClassName": {
          "type": "string",
          "description": "type: ingress のときの IngressClass。空の間はクラスタの既定に従う。"
        },
        "exposure": {
          "type": "object",
          "properties": {
            "annotations": { "type": "object" },
            "middlewareRefs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "workspaceNamespace": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace / WorkspaceTemplate を置くネームスペース。"
    },
    "createWorkspaceNamespace": {
      "type": "boolean",
      "description": "workspaceNamespace という名前の Namespace リソースを生成するか (3.5/3.6)。false では利用者が事前に用意する。"
    },
    "workspaceQuota": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "workspaceNamespace への ResourceQuota を生成するか (3.5/3.6)。false では利用者が資源上限を自分で用意する。"
        }
      }
    },
    "workspaceNetworkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "workspaceNamespace への NetworkPolicy (通信制限) を生成するか (3.5/3.6)。false では利用者が同等の制限を自分で用意する。"
        }
      }
    },
    "priorityClass": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "workspaceTemplate.priorityClassName と同名の PriorityClass を生成するか (3.5/3.6)。false では利用者が事前に用意する。"
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "clusterNodeAccess": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "ノード read-only の ClusterRole/ClusterRoleBinding を生成するか (3.5/3.6)。false ではイメージ事前配置チェックが機能しなくなる。"
            }
          }
        }
      }
    },
    "workspaceImage": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "workspaceTemplate": {
      "type": "object",
      "required": ["database", "auth", "evacuation"],
      "properties": {
        "database": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "ブランチ専用データベースを使うか (3.4/3.5)。既定 true。false ではこの chart が payload とする WorkspaceTemplate に spec.database を含めず、コントローラは CNPG 資源を一切生成しない (DatabaseAdapter が no-op 実装になる) — ワークスペースはデータベースなしで払い出される。egress 許可先を指す独立の値である database.namespace とは別の関心事 (README 参照)。"
            },
            "clusterRef": {
              "type": "string",
              "minLength": 1,
              "description": "ブランチ専用データベース (Cluster リソース名等) への参照。enabled: true のときだけ必須 (下の allOf)。"
            }
          }
        },
        "auth": {
          "type": "object",
          "required": ["secretRef"],
          "properties": {
            "secretRef": { "type": "string", "minLength": 1 }
          }
        },
        "evacuation": {
          "type": "object",
          "required": ["bucket", "endpoint", "region", "secretRef"],
          "properties": {
            "bucket": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 },
            "secretRef": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "taskQueue": {
      "type": "object",
      "required": ["maxConcurrent"],
      "properties": {
        "maxConcurrent": { "type": "integer", "minimum": 1 }
      }
    },
    "infisical": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Infisical Operator による秘匿情報同期を使うか (3.3)。既定 false では workspaceTemplate.auth.secretRef と infisical.inferenceCredentialsSecretName を利用者が用意した Secret 名として参照するだけになり、projectId 等の接続情報は不要。"
        },
        "projectId": { "type": "string" },
        "environmentSlug": { "type": "string" },
        "secretPath": { "type": "string" },
        "authRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" }
          }
        }
      }
    },
    "evacuationCredentials": {
      "type": "object",
      "properties": {
        "autoProvision": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "garage": {
              "type": "object",
              "properties": {
                "namespace": { "type": "string" },
                "podSelector": { "type": "string" },
                "keyName": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "ブランチ専用データベースを使う場合(workspaceTemplate.database.enabled、既定true)、参照先クラスタ名が要る(3.4/3.5)。",
      "if": {
        "properties": {
          "workspaceTemplate": {
            "properties": {
              "database": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["database"]
          }
        },
        "required": ["workspaceTemplate"]
      },
      "then": {
        "properties": {
          "workspaceTemplate": {
            "properties": {
              "database": {
                "required": ["clusterRef"],
                "properties": {
                  "clusterRef": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "秘匿情報同期にInfisical Operatorを使う場合(infisical.enabled=true)、接続先プロジェクトの情報が要る(3.3)。",
      "if": {
        "properties": {
          "infisical": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["infisical"]
      },
      "then": {
        "properties": {
          "infisical": {
            "required": ["projectId", "environmentSlug", "secretPath", "authRef"],
            "properties": {
              "projectId": { "type": "string", "minLength": 1 },
              "environmentSlug": { "type": "string", "minLength": 1 },
              "secretPath": { "type": "string", "minLength": 1 },
              "authRef": {
                "type": "object",
                "required": ["name", "namespace"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "namespace": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "退避先S3資格情報の自動発行(3.4/3.7)を有効にした場合、発行対象のGarage情報が要る。",
      "if": {
        "properties": {
          "evacuationCredentials": {
            "properties": {
              "autoProvision": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["autoProvision"]
          }
        },
        "required": ["evacuationCredentials"]
      },
      "then": {
        "properties": {
          "evacuationCredentials": {
            "properties": {
              "autoProvision": {
                "properties": {
                  "garage": {
                    "type": "object",
                    "required": ["namespace", "podSelector", "keyName"],
                    "properties": {
                      "namespace": { "type": "string", "minLength": 1 },
                      "podSelector": { "type": "string", "minLength": 1 },
                      "keyName": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "required": ["garage"]
              }
            }
          }
        }
      }
    }
  ]
}
